# SEC EDGAR identity. Use "Name email@example.com".
# Leave unset for local mock ingestion.
EDGAR_IDENTITY=

# Number of recent calendar days to scan for 8-K filings during cron.
EDGAR_LOOKBACK_DAYS=7

# First-stage LLM provider. Use mock for local development and tests.
LLM_PROVIDER=mock
LLM_FIRST_STAGE_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shared Event storage. Use local for development and r2 for production.
STORAGE_BACKEND=local
STORAGE_ROOT=worker/data/summaries
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_KEY_PREFIX=

# Optional local data override. Defaults to worker/data/worker.db.
WORKER_DB_PATH=worker/data/worker.db

# iOS app local API defaults.
WORKER_HOST=localhost
WORKER_PORT=8787
