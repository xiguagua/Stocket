# SEC EDGAR identity. Use "Name email@example.com".
# Leave unset for local mock ingestion.
EDGAR_IDENTITY=

# Optional local data overrides. Defaults are worker/data/worker.db and worker/data/summaries.
WORKER_DB_PATH=worker/data/worker.db
STORAGE_ROOT=worker/data/summaries

# iOS app local API defaults.
WORKER_HOST=localhost
WORKER_PORT=8787
